{
  "name": "m2y",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.20",
    "@expo/ui": "~56.0.26",
    "@shopify/flash-list": "2.0.2",
    "expo": "~56.0.20",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.24",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.25",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.10",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.12",
    "expo-linking": "~56.0.17",
    "expo-local-authentication": "~56.0.5",
    "expo-router": "~56.2.19",
    "expo-screen-capture": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "^1.20.1",
    "husky": "^9.1.7",
    "jest-expo": "~56.0.5",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src scripts modules app.config.ts eslint.config.js jest.setup.js --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js}\" \"modules/**/*.{json,js,ts}\" \"contracts/**/*.json\" \"*.{json,js,cjs,ts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js}\" \"modules/**/*.{json,js,ts}\" \"contracts/**/*.json\" \"*.{json,js,cjs,ts}\" \".github/**/*.yml\"",
    "deps:check": "depcruise --config .dependency-cruiser.cjs app src",
    "test": "jest",
    "test:migrations": "jest src/data/sqlite/migrations.test.ts",
    "test:native:crypto": "node scripts/build-android-debug.mjs --tasks :m2y-crypto:testDebugUnitTest",
    "config:check": "node scripts/verify-app-config.mjs",
    "doctor": "expo-doctor",
    "prebuild:android": "expo prebuild --clean --no-install --platform android",
    "build:android:debug": "node scripts/build-android-debug.mjs",
    "build:android:debug:arm64": "node scripts/build-android-debug.mjs -PreactNativeArchitectures=arm64-v8a",
    "server:format": "pnpm --filter @m2y/server format",
    "server:format:check": "pnpm --filter @m2y/server format:check",
    "server:typecheck": "pnpm --filter @m2y/server typecheck",
    "server:lint": "pnpm --filter @m2y/server lint",
    "server:test": "pnpm --filter @m2y/server test",
    "server:test:migrations": "pnpm --filter @m2y/server test:migrations",
    "server:build": "pnpm --filter @m2y/server build",
    "prepare": "husky"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.85.3": "patches/@react-native__gradle-plugin@0.85.3.patch"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/app/**/*.test.ts",
      "<rootDir>/app/**/*.test.tsx",
      "<rootDir>/modules/**/*.test.ts",
      "<rootDir>/modules/**/*.test.tsx",
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/README.md"
    ]
  }
}
