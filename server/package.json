{
  "name": "@m2y/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,js,cjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,js,cjs}\"",
    "lint": "eslint src test --max-warnings 0",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:migrations": "jest --runInBand src/persistence/database.service.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/throttler": "6.5.0",
    "better-sqlite3": "13.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
